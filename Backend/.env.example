# Database configuration
DB_TYPE=mysql
DB_HOST=
DB_# Duración de la sesión del personal (minutos, horas o días: 90m, 8h, 1d).
# Por defecto 3h. Se cuenta desde el login, no se renueva con el uso: para un
# turno de trabajo completo conviene que cubra la jornada (por ejemplo 10h).
# Cuanto más larga, más tiempo sirve un token robado: se puede cerrar la sesión
# de un usuario cambiándole la clave.
JWT_EXPIRES_IN=

PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# JWT
SECRET_WORD=

# Clave (mínimo 16 caracteres) que cifra los secretos de la verificación en dos
# pasos y los tokens de las pantallas de sala. Opcional: si no está, se deriva de
# SECRET_WORD. OJO: cambiarla (o cambiar SECRET_WORD si no está) deja ilegibles
# esos secretos guardados: los usuarios con 2FA tendrían que reconfigurarla.
# Los respaldos guardan el .env aparte justamente por esto.
TWO_FACTOR_KEY=

# Mailer (recuperación de contraseña)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Nombre del remitente que ve el usuario en el mail de recuperación. Sin
# definir, usa "Soporte".
MAIL_FROM_NAME=

# URL del frontend para armar el link del mail de recuperación de clave
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma (ej: "https://turnos.miconsultorio.com").
# Sin definir, se permite solo FRONTEND_URL (nunca "*").
CORS_ORIGIN=

# Solo si la API corre detrás de un reverse proxy / balanceador: "true", la
# cantidad de saltos (ej. "1") o las IPs del proxy separadas por coma. Sin
# definir, no se confía en X-Forwarded-For (lo seguro sin proxy).
TRUST_PROXY=

# "true" apaga las tareas programadas (recordatorios de turno). Los tests e2e
# lo usan; en producción dejarlo vacío.
DISABLE_SCHEDULED_JOBS=

PORT=3006

# /auth/nuevo-usuario requiere ser ADMIN, así que una base de datos nueva no
# tiene forma de crear el primer usuario. Si no existe ningún ADMIN todavía
# y SEED_ADMIN_NICK/SEED_ADMIN_PASSWORD están seteadas, se crea ese usuario
# automáticamente al arrancar (ver AppService.seedInitialAdmin) — el email
# es opcional. Sacar estas líneas del .env después del primer arranque de
# un proyecto nuevo.
SEED_ADMIN_NICK=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
