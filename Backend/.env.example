# Turnero: variables de entorno del BACKEND (desarrollo).
# Copiar como ".env" (cp .env.example .env) y completar. El ".env" real NUNCA va al repositorio.
#
# Las variables que son claves o contraseñas quedan VACÍAS a propósito: si falta una obligatoria, la API
# no arranca y lo dice (mejor que arrancar con una clave de relleno). Para PRODUCCIÓN no uses este archivo:
# usá docs/despliegue/backend.env.produccion.ejemplo y la guía docs/GUIA-DE-DESPLIEGUE.md.
# Claves aleatorias: openssl rand -hex 32

# ---------------------------------------------------------------- base de datos (MySQL 8.4)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turnero
# Usuario de la APP: sin permisos de estructura (crear/borrar tablas). Ver README, "Base de datos".
DB_USERNAME=turnero_app
DB_PASSWORD=

# Las migraciones necesitan un usuario con permisos de estructura. Se pasan SOLO en el momento de correrlas,
# nunca en este archivo:
#   MIGRATION_DB_USER=root MIGRATION_DB_PASSWORD=<clave> npm run migration:run

# ---------------------------------------------------------------- seguridad
# OBLIGATORIA. Firma las sesiones (mínimo 16 caracteres). Si cambia, todos tienen que volver a entrar.
SECRET_WORD=
# Opcional (mínimo 16 caracteres). Cifra los secretos de la verificación en dos pasos y los tokens de las
# pantallas de sala. Si no está, se deriva de SECRET_WORD.
# OJO: cambiarla (o cambiar SECRET_WORD si esta no está) deja ilegibles esos secretos guardados: los usuarios
# con 2FA tendrían que configurarla de nuevo. Los respaldos guardan el .env aparte justamente por esto.
TWO_FACTOR_KEY=
# Duración de la sesión del personal: minutos, horas o días (90m, 8h, 1d). Por defecto 3h.
# Se cuenta desde el login y no se renueva con el uso: para una jornada completa conviene 10h.
# Cuanto más larga, más tiempo sirve un token robado (se puede cerrar la sesión de un usuario cambiándole la clave).
JWT_EXPIRES_IN=

# ---------------------------------------------------------------- red
# Dirección en la que escucha la API. Sin definir escucha en TODAS las interfaces (cómodo en desarrollo).
# En producción, detrás de nginx: 127.0.0.1, así nadie puede llegar a la API sin pasar por nginx.
HOST=
# Puerto de la API.
PORT=3006
# Dirección pública de la web (sin barra final). La API la usa para armar los links de los correos
# (recuperar clave) y de los avisos al paciente (confirmar asistencia, Mi turno), y como origen CORS.
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (ej. "https://turnos.miconsultorio.com").
# Sin definir, se permite solo FRONTEND_URL (nunca "*").
CORS_ORIGIN=
# Solo si la API corre detrás de un proxy / balanceador: "true", la cantidad de saltos (ej. "1") o las IPs
# del proxy separadas por coma. Sin definir, no se confía en X-Forwarded-For (lo seguro sin proxy).
# Con nginx en el mismo servidor: 1.
TRUST_PROXY=

# ---------------------------------------------------------------- correo (recuperar clave, comprobantes, recordatorios)
# Sin MAIL_USER el sistema funciona igual, pero no manda correos.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Nombre del remitente que ve el usuario. Sin definir, usa "Soporte".
MAIL_FROM_NAME=

# ---------------------------------------------------------------- tareas programadas
# "true" apaga las tareas programadas (recordatorios de turno). Los tests e2e lo usan.
# En producción dejarlo vacío.
DISABLE_SCHEDULED_JOBS=

# ---------------------------------------------------------------- primer administrador
# /auth/nuevo-usuario requiere ser ADMIN, así que una base nueva no tiene forma de crear el primer usuario.
# Si no existe ningún ADMIN y SEED_ADMIN_NICK y SEED_ADMIN_PASSWORD están definidas, se crea ese usuario al
# arrancar (ver AppService.seedInitialAdmin). El email es opcional.
# Sacar estas tres líneas del .env después del primer arranque.
SEED_ADMIN_NICK=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
