# Turnero: variables de entorno del BACKEND en producción.
# Instalar como: /opt/turnero/Backend/.env   (dueño turnero:turnero, permisos 640)
#
# Reglas:
#  - Todo lo que está entre < > es un MARCADOR: hay que reemplazarlo (con los símbolos < > incluidos).
#    Antes de arrancar, este comando NO debe mostrar nada:   grep -n '<' /opt/turnero/Backend/.env
#    (un marcador olvidado en una clave se aceptaría como clave real).
#  - Claves y contraseñas: se generan con  openssl rand -hex 32  (una distinta para cada una).
#  - Sin comillas ni espacios alrededor del "=".
#  - Este archivo NUNCA va al repositorio. Los respaldos lo guardan cifrado aparte (ver RESPALDOS.md).

# ---------------------------------------------------------------- base de datos (MySQL 8.4)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turnero
# Usuario de la APP: sin permisos de estructura (paso 6 de la guía). NO es root.
DB_USERNAME=turnero_app
DB_PASSWORD=<CLAVE_DE_turnero_app>

# ---------------------------------------------------------------- seguridad
# Firma las sesiones (mínimo 16 caracteres). Si cambia, todos tienen que volver a entrar.
SECRET_WORD=<GENERAR_CLAVE_ALEATORIA>
# Cifra los secretos de la verificación en dos pasos y los tokens de las pantallas de sala.
# Recomendado: una propia (distinta de SECRET_WORD). OJO: si se cambia después, los usuarios con 2FA
# tendrían que configurarla de nuevo y las pantallas de sala necesitarían un token nuevo.
TWO_FACTOR_KEY=<GENERAR_OTRA_CLAVE_ALEATORIA>
# Duración de la sesión del personal (90m, 8h, 1d). Por defecto 3h. No se renueva con el uso:
# para cubrir una jornada completa conviene 10h. Cuanto más larga, más tiempo sirve un token robado.
JWT_EXPIRES_IN=10h

# ---------------------------------------------------------------- red y proxy
# Dirección en la que escucha la API: 127.0.0.1 (solo el propio servidor). nginx le habla ahí, y desde la red
# no se puede llegar a la API sin pasar por nginx (que es el que pone HTTPS y los límites de pedido).
# Sin esta variable la API escucha en TODAS las interfaces y depende solo del firewall.
HOST=127.0.0.1
PORT=3006
# Dirección pública de la web, con https y SIN barra final. La API la usa para armar los links de los
# correos (recuperar clave) y de los avisos al paciente (confirmar asistencia, Mi turno), y como
# origen permitido por CORS.
FRONTEND_URL=https://DOMINIO-A-DEFINIR
# Orígenes permitidos por CORS, separados por coma. Con la web y la API en el mismo dominio (así está
# armado nginx) se deja vacío y se usa FRONTEND_URL. Nunca "*".
CORS_ORIGIN=
# La API corre DETRÁS de nginx (una sola capa): 1. Sin esto, todos los usuarios se verían con la IP de
# nginx: los límites de intentos (login, reserva) cortarían a todos juntos y la auditoría guardaría
# siempre la misma IP.
TRUST_PROXY=1

# ---------------------------------------------------------------- correo (recuperar clave, avisos)
# Si no se completan, el sistema funciona igual pero NO manda correos (ni recordatorios ni comprobantes).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=<CORREO_DEL_CONSULTORIO>
MAIL_PASSWORD=<CLAVE_DE_APLICACION_DEL_CORREO>
# Nombre que ve el paciente como remitente
MAIL_FROM_NAME=<NOMBRE_DEL_CONSULTORIO>

# ---------------------------------------------------------------- tareas programadas
# En producción dejar VACÍO (los recordatorios de turno necesitan estas tareas). Y correr UNA sola copia
# de la API: con dos, cada una tendría sus propias tareas y sus propios contadores de límites.
DISABLE_SCHEDULED_JOBS=

# ---------------------------------------------------------------- primer administrador
# Con la base nueva no existe ningún usuario. Si no hay ningún ADMIN y estas variables están,
# la API crea ese administrador al arrancar. DESPUÉS DEL PRIMER ARRANQUE: borrar estas tres líneas
# (SEED_ADMIN_*) y reiniciar el servicio. La clave se cambia luego desde "Mi perfil".
SEED_ADMIN_NICK=<USUARIO_DEL_PRIMER_ADMINISTRADOR>
SEED_ADMIN_EMAIL=<CORREO_DEL_ADMINISTRADOR>
SEED_ADMIN_PASSWORD=<CLAVE_DEL_PRIMER_ADMINISTRADOR>
