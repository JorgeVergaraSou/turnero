# Turnero: variables del FRONTEND para generar la versión de producción (npm run build).
# Instalar como: /opt/turnero/Frontend/.env.production
# Se leen SOLO al compilar: si se cambian, hay que volver a compilar y copiar la web (paso 11 de la guía).
# Este archivo no lleva secretos (todo lo que se pone acá queda visible en la web publicada).

# Dirección de la API: ABSOLUTA, con https, terminada en /api y sin barra final.
# Tiene que ser una URL completa (no "/api"): la compilación la usa para armar la política de seguridad
# del navegador (CSP) y falla si no es válida.
VITE_API_BASE_URL=https://DOMINIO-A-DEFINIR/api

# Dirección pública del sitio, con https y SIN barra final. Va en las etiquetas de vista previa
# (Open Graph) de los links compartidos por WhatsApp y redes.
VITE_SITE_URL=https://DOMINIO-A-DEFINIR

# Nombre de respaldo del consultorio (mientras carga la configuración, o si la API no responde).
# El nombre real se cambia desde el panel (Administración > Configuración).
VITE_CLINIC_NAME=<NOMBRE_DEL_CONSULTORIO>
